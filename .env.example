# =============================================================================
# Churn Re-Engagement Platform — Environment Variable Template
# Copy this file to `.env` and fill in the real values.
# `.env` must never be committed to the repository.
# =============================================================================

# --- General ---
ENVIRONMENT=dev                      # dev | staging | prod
LOG_LEVEL=INFO

# --- Serving (API) ---
SERVING_HOST=127.0.0.1
SERVING_PORT=8010
# Prototype API keys. Replace with a real identity provider / RBAC in production.
API_KEY=dev-admin-key
API_READ_KEY=dev-read-key

# --- Action safety limits ---
ACTION_BUDGET_LIMIT=10000
ACTION_MAX_RECIPIENTS=100
ACTION_COST_PER_COUPON=50

# --- Data Warehouse (Snowflake / BigQuery / DuckDB) ---
# DuckDB can be used for the prototype; Snowflake/BigQuery for enterprise.
WAREHOUSE_DSN=duckdb:///data/processed/warehouse.duckdb
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# --- Feature Store (Feast) ---
FEAST_REPO_PATH=feature_repo/
FEAST_REGISTRY=s3://mlflow/registry  # or local: data/feature_store/registry.db

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://mlflow/artifacts

# --- Vector DB (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_password

# --- MinIO / S3-compatible object storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mlflow

# --- LLM (Agentic AI layer) ---
# Configured through the provider abstraction layer in enterprise usage.
LLM_PROVIDER=deepseek             # openai | anthropic | azure | bedrock | ollama | deepseek | mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- CRM / ESP integrations ---
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
ESP_PROVIDER=braze                # braze | klaviyo | salesforce_mc
ESP_API_KEY=

# --- KVKK / PII ---
PII_VAULT_URL=
ENCRYPTION_KEY=
